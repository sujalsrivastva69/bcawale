# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bcawale?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d
PORT=4000

# Where the Next.js frontend runs (used for CORS)
CLIENT_ORIGIN=http://localhost:3000
